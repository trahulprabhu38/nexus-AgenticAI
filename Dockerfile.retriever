FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# System deps for faiss-cpu and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Install retriever-specific Python deps
COPY retriever_agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the retriever_agent package contents into /app
COPY retriever_agent/ .

# Ensure sample_data directory exists (index files may be mounted or built at runtime)
RUN mkdir -p /app/sample_data

EXPOSE 8007

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8007"]
